{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes YouTube Signal Scout Video",
  "type": "object",
  "required": ["video_id", "url", "title", "channel_id", "channel_title", "published_at", "duration_seconds", "matched_fields", "topic_score", "score_components", "ranking_signals", "quality_flags", "reason"],
  "additionalProperties": true,
  "properties": {
    "video_id": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri"},
    "title": {"type": "string"},
    "channel_id": {"type": "string"},
    "channel_title": {"type": "string"},
    "published_at": {"type": "string", "format": "date-time"},
    "description_excerpt": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "category_id": {"type": ["string", "null"]},
    "duration_seconds": {"type": "integer", "minimum": 0},
    "statistics": {
      "type": "object",
      "properties": {
        "view_count": {"type": "integer", "minimum": 0},
        "like_count": {"type": "integer", "minimum": 0},
        "comment_count": {"type": "integer", "minimum": 0}
      }
    },
    "matched_fields": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "topic_score": {"type": "number", "minimum": 0, "maximum": 1},
    "score_components": {
      "type": "object",
      "required": ["topic_relevance", "freshness", "view_velocity", "smoothed_engagement", "channel_credibility", "information_completeness"],
      "additionalProperties": false,
      "properties": {
        "topic_relevance": {"type": "number", "minimum": 0, "maximum": 0.45},
        "freshness": {"type": "number", "minimum": 0, "maximum": 0.15},
        "view_velocity": {"type": "number", "minimum": 0, "maximum": 0.15},
        "smoothed_engagement": {"type": "number", "minimum": 0, "maximum": 0.1},
        "channel_credibility": {"type": "number", "minimum": 0, "maximum": 0.1},
        "information_completeness": {"type": "number", "minimum": 0, "maximum": 0.05}
      }
    },
    "ranking_signals": {
      "type": "object",
      "required": ["raw_scores", "smoothed_engagement_rate", "view_velocity_per_hour", "view_velocity_source"],
      "properties": {
        "raw_scores": {"type": "object"},
        "smoothed_engagement_rate": {"type": "number", "minimum": 0},
        "view_velocity_per_hour": {"type": "number", "minimum": 0},
        "view_velocity_source": {"type": "string", "enum": ["snapshot_delta", "lifetime_average", "unavailable"]}
      }
    },
    "quality_flags": {
      "type": "object",
      "required": ["is_short", "possible_ad", "possible_entertainment", "possible_exam_training", "low_signal"],
      "properties": {
        "is_short": {"type": "boolean"},
        "possible_ad": {"type": "boolean"},
        "possible_entertainment": {"type": "boolean"},
        "possible_exam_training": {"type": "boolean"},
        "low_signal": {"type": "boolean"}
      }
    },
    "reason": {"type": "string"}
  }
}
