{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes YouTube Signal Scout Input",
  "type": "object",
  "required": ["topic"],
  "additionalProperties": true,
  "properties": {
    "topic": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["discovery", "channel_watch", "hybrid"], "default": "discovery"},
    "search_query": {"type": "string", "minLength": 1},
    "include_keywords": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "exclude_keywords": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "target_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "channel_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "channel_urls": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "trusted_channel_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "zones": {
      "type": "array",
      "items": {"type": "string", "enum": ["east_asia", "europe", "north_america"]},
      "default": ["east_asia", "europe", "north_america"]
    },
    "region_code": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$", "default": null},
    "region_codes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}$"}, "default": []},
    "region_priority_tiers": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "minItems": 1
      },
      "default": [["US", "JP", "HK", "GB"], ["KR", "TW", "DE", "FR", "CA"]]
    },
    "relevance_language": {"type": ["string", "null"], "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$", "default": null},
    "localized_queries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "ja": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "zh-Hant": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "ko": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "de": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "fr": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      },
      "default": {}
    },
    "published_after": {"type": ["string", "null"], "format": "date-time"},
    "published_before": {"type": ["string", "null"], "format": "date-time"},
    "lookback_days": {"type": ["integer", "null"], "minimum": 1, "default": 7},
    "order": {"type": "string", "enum": ["date", "relevance", "viewCount", "rating"], "default": "relevance"},
    "max_results": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10},
    "target_results": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10},
    "max_videos_per_channel": {"type": "integer", "minimum": 1, "maximum": 50, "default": 1},
    "max_search_pages": {"type": "integer", "minimum": 1, "maximum": 5, "default": 1},
    "adaptive_max_search_pages": {"type": "integer", "minimum": 0, "maximum": 4, "default": 1},
    "candidates_per_page": {"type": "integer", "minimum": 1, "maximum": 50, "default": 50},
    "channel_max_results": {"type": "integer", "minimum": 1, "maximum": 50, "default": 20},
    "hydration_batch_size": {"type": "integer", "minimum": 1, "maximum": 50, "default": 50},
    "min_views": {"type": "integer", "minimum": 0, "default": 0},
    "max_duration_seconds": {"type": "integer", "minimum": 1, "default": 3600},
    "include_shorts": {"type": "boolean", "default": false},
    "shorts_max_duration_seconds": {"type": "integer", "minimum": 1, "default": 60},
    "topic_score_threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.45},
    "engagement_prior_views": {"type": "integer", "minimum": 1, "default": 1000},
    "channel_quality_scores": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1},
      "default": {}
    },
    "score_match_cap": {"type": "integer", "minimum": 1, "default": 3},
    "reject_possible_ads": {"type": "boolean", "default": true},
    "reject_entertainment": {"type": "boolean", "default": true},
    "reject_exam_training": {"type": "boolean", "default": true},
    "blocked_exam_training_channel_names": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": [
        "Vajiram and Ravi",
        "Drishti IAS",
        "Vision IAS",
        "StudyIQ IAS",
        "PW OnlyIAS",
        "NEXT IAS",
        "InsightsIAS",
        "ForumIAS",
        "Shankar IAS Academy",
        "Rau's IAS Study Circle",
        "Unacademy UPSC",
        "BYJU'S IAS",
        "Adda247",
        "Testbook",
        "資格の学校TAC",
        "LEC東京リーガルマインド",
        "アガルート",
        "クレアール",
        "公務員試験予備校EYE",
        "スタディング",
        "공단기",
        "메가공무원",
        "해커스공무원",
        "에듀윌 공무원",
        "박문각 공무원",
        "中公教育",
        "华图教育",
        "華圖教育",
        "粉笔公考",
        "粉筆公考",
        "粉笔教育",
        "粉筆教育"
      ]
    },
    "blocklisted_channel_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "output_dir": {"type": ["string", "null"], "default": null},
    "cache_enabled": {"type": "boolean", "default": true},
    "cache_path": {"type": ["string", "null"], "default": null},
    "video_cache_ttl_hours": {"type": "integer", "minimum": 0, "default": 24},
    "retry_attempts": {"type": "integer", "minimum": 0, "maximum": 10, "default": 2},
    "retry_backoff_seconds": {"type": "number", "minimum": 0, "default": 1},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 30}
  }
}
