{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes YouTube Signal Scout Weekly Input",
  "type": "object",
  "required": ["topics", "email"],
  "additionalProperties": false,
  "properties": {
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cron": {"type": "string", "minLength": 1, "default": "0 9 * * 1"},
        "timezone": {"type": "string", "minLength": 1, "default": "Asia/Tokyo"}
      }
    },
    "defaults": {"type": "object"},
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["topic"],
            "properties": {"topic": {"type": "string", "minLength": 1}},
            "additionalProperties": true
          }
        ]
      }
    },
    "email": {
      "type": "object",
      "required": ["account", "sender", "recipients"],
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "sender": {
          "type": "string",
          "format": "email",
          "pattern": "^[^\\r\\n]+$"
        },
        "recipients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "email",
            "pattern": "^[^\\r\\n]+$"
          }
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        }
      }
    },
    "continue_on_error": {"type": "boolean", "default": true}
  }
}
