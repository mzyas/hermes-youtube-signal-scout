{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes YouTube Signal Scout Result",
  "type": "object",
  "required": ["run_id", "skill", "topic", "mode", "created_at", "query_plan", "quota_usage_estimate", "videos", "rejected"],
  "additionalProperties": true,
  "properties": {
    "run_id": {"type": "string"},
    "skill": {"const": "hermes-youtube-signal-scout"},
    "topic": {"type": "string"},
    "mode": {"type": "string"},
    "created_at": {"type": "string"},
    "query_plan": {"type": "object"},
    "quota_usage_estimate": {"type": "object"},
    "videos": {"type": "array", "items": {"$ref": "video.schema.json"}},
    "rejected": {"type": "array", "items": {"type": "object"}},
    "output_files": {
      "type": "object",
      "required": ["markdown", "json"],
      "properties": {
        "markdown": {"type": "string"},
        "json": {"type": "string"}
      }
    }
  }
}
